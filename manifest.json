{
  "manifest_version": 3,
  "name": "0T-YT",
  "description": "Zero Translation YouTube: keeps video titles in their original uploaded language.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/16.16.png",
    "32": "icons/32.32.png",
    "48": "icons/48.48.png",
    "128": "icons/128.128.png"
  },
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://m.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["interceptor.js"],
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"]
    }
  ]
}